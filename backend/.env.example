# ---------------------------------------------------------------------------
# HDFC Fund Facts — backend configuration
# Copy to `.env` and fill in values. `.env` is git-ignored; never commit it.
# The same variable names are used locally and on Render.
# ---------------------------------------------------------------------------

# --- LLM (server-side only) ----------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
# Read only by the Python backend. Never expose it to the browser.
GEMINI_API_KEY=
LLM_PROVIDER=gemini
# Current Gemini model available to this project. Older IDs (gemini-2.5-flash,
# gemini-2.0-flash) are retired for new API users.
LLM_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0.1
# This budget covers the model's internal thinking tokens AND the visible answer.
# gemini-3.8-flash reasons for several hundred tokens, so a small value leaves no
# room for the answer and the response is cut off mid-sentence.
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=2

# --- Embeddings (local model, no external API) ---------------------------
# Runs on ONNX Runtime via fastembed, not PyTorch: importing torch costs ~750 MB RSS
# and does not fit Render's 512 MB instance. Same model, same vector space, so an
# existing index stays valid.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# ONNX Runtime's CPU memory arena grows to the largest activation it has ever seen and
# never returns it, so peak RSS is set by this number rather than by the corpus
# (77 chunks x 384 dims is under 1 MB of vectors). Measured peak of the full corpus:
#   arena on,  batch 32 -> 451 MB      arena off, batch 32 -> 353 MB
#   arena on,  batch  8 -> 301 MB      arena off, batch  8 -> 275 MB
# Leaving the arena off also runs ~35% faster here (9.2s vs 14.2s), because the
# arena's grow-and-copy bookkeeping costs more than malloc/free at this size.
EMBEDDING_ENABLE_CPU_MEM_ARENA=false
EMBEDDING_BATCH_SIZE=4
# 1 is right for Render Free (0.1 CPU); raise only on a real multi-core host.
EMBEDDING_THREADS=1
# Where the downloaded ONNX weights are cached. Unset leaves it to fastembed, which
# writes into the source tree on Render. Point it at scratch space in production.
FASTEMBED_CACHE_PATH=/tmp/fastembed_cache

# --- Vector store ---------------------------------------------------------
# CHROMA_MODE=persistent | ephemeral
#   persistent  -> index is written to CHROMA_PERSIST_DIRECTORY
#   ephemeral   -> in-memory; data is lost on restart/redeploy
#
# Render note: Free instances have no persistent disk, so this path is scratch space
# and the index is rebuilt on every cold start by scripts/ingest.py. It must stay
# `persistent` even so, because ingest.py and uvicorn are separate processes and
# hand the index to each other through the filesystem. A paid instance with a mounted
# disk can use /var/data to keep the index across restarts.
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION=hdfc_mutual_fund_faq
CHROMA_MODE=persistent

# --- Retrieval ------------------------------------------------------------
TOP_K=5
SIMILARITY_THRESHOLD=0.45
RETRIEVE_CANDIDATES=12
MAX_CONTEXT_CHARS=9000
MAX_MESSAGE_LENGTH=1000

# --- Ingestion ------------------------------------------------------------
# Sources are fetched over the network; there is no bundled copy. The index is
# therefore rebuilt by scripts/ingest.py, which the Render start command runs on
# every cold start.
SOURCES_FILE=./sources.json
INGESTION_TIMEOUT_SECONDS=20
INGESTION_MAX_BYTES=4000000
INGESTION_MAX_ATTEMPTS=3
# Leave false. The Render start command already ingests explicitly; this flag would
# only repeat that work inside the app process.
AUTO_INGEST_ON_STARTUP=false

# --- API / security -------------------------------------------------------
# Comma-separated explicit origins. Must never be '*' in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Comma-separated hostname suffixes accepted as https-only subdomains, e.g.
# ".onrender.com". This is what lets a Render deployment accept its own frontend
# without anyone having to enter the generated hostname, so the production setup
# needs no manual CORS value. Not a credential: it grants no access, it only
# satisfies the browser's same-origin check.
ALLOWED_ORIGIN_SUFFIXES=
ENVIRONMENT=local
ENABLE_DOCS=true
# Retrieval diagnostics in API responses. Keep false in production.
DEBUG_RAG=false
MAX_REQUEST_BYTES=16384
LOG_LEVEL=INFO
SERVICE_NAME=niva-api

# --- Chunking -------------------------------------------------------------
CHUNK_TARGET_TOKENS=700
CHUNK_OVERLAP_TOKENS=80
CHUNK_MIN_TOKENS=40
CHUNK_COMPACT_TOKEN_LIMIT=140
